#!/bin/zsh
#
# stayawaked - keeps a Mac awake, lid closed included, while work is in progress.
#
# macOS honours caffeinate's PreventUserIdleSystemSleep assertion only while the
# lid is open; closing the lid sleeps regardless. The only switch that survives a
# lid close is `pmset disablesleep`, which needs root and persists across reboots.
# So this helper owns that switch and mirrors the assertions the system already
# tracks: while at least one caffeinate process exists, sleep is disabled.
#
# Tools that do long work already take that assertion. Claude Code, for one,
# spawns `caffeinate -i -t 300` as a child of each session that is actively
# working and renews it, so parallel jobs, and jobs that spawn other jobs,
# reference-count themselves for free.
#
# The central setting is IDLE_WINDOW. An assertion is dropped and re-taken
# constantly (between turns, between phases, while one agent waits on another),
# so "no assertion right now" does not mean "finished". Only the LENGTH of the
# quiet period distinguishes the two, and IDLE_WINDOW is where that line is
# drawn: everything must be quiet for that long before sleep is allowed.
#
# There is deliberately no maximum hold. Long runs must not be cut off midway.
# REMIND_EVERY instead surfaces a hold that has been forgotten, without ending it.
#
emulate -L zsh
set -u
zmodload zsh/datetime

LOG=/var/log/stayawaked.log

# Filled in by resolve_user(), which follows whoever is logged in rather than
# baking in a name, so the same helper works on any Mac and any account.
USER_NAME=
USER_ID=
STATE_DIR=
CONFIG=
STATE=
LEASE=
VETO=
SCHEDULE=

# Defaults. Anything here can be overridden per machine in the config file.
POLL=5
IDLE_WINDOW=3600
REMIND_EVERY=21600
BATTERY_FLOOR=15
NOTIFY=all
MATCH=caffeinate

# Wake events this tool creates are tagged with this owner, so they can be
# cancelled precisely and power schedules set up by anything else are never
# touched. `pmset repeat` is deliberately not used: the machine has only one
# repeating schedule and it may not be ours to take.
SCHED_OWNER=com.macstayawake
DOW_LETTERS=(M T W R F S U)

log() {
  print -r -- "$(strftime '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS) $*" >> $LOG
  chmod 644 $LOG 2>/dev/null
  if [[ -f $LOG ]] && (( $(stat -f %z $LOG) > 524288 )); then
    mv -f $LOG $LOG.1
  fi
}

write_defaults() {
  cat > $CONFIG <<'CONF'
# Settings for stayawake. The menu bar app writes this file, and the helper
# re-reads it every few seconds, so changes take effect without a restart.

POLL=5              # seconds between checks

IDLE_WINDOW=3600    # 1h: everything must be quiet this long before sleep is allowed.
                    # Work stops and starts constantly, so this is what separates
                    # "between phases" from "finished". Raise it for long agent runs.

REMIND_EVERY=21600  # 6h: remind me the Mac is still being kept awake. 0 = never.
                    # Nothing is ever cut off; this only tells you it is happening.

BATTERY_FLOOR=15    # %: stop keeping awake when discharging at or below this

NOTIFY=all          # all | forced | none
MATCH=caffeinate    # process name that counts as work in progress

# Wake times live in the `schedule` file next to this one, one per line, as a
# time and the days it applies to:  08:00 MTWRF
# While the Mac sleeps nothing scheduled runs, so a wake is how overnight work
# gets a chance to carry on.
CONF
  chown $USER_NAME $CONFIG 2>/dev/null
  chmod 644 $CONFIG 2>/dev/null
}

# Follows the logged-in GUI user. Returns 1 when nobody is logged in, which is
# normal at the login window and means there is nothing to manage yet.
resolve_user() {
  local u home
  u=$(stat -f %Su /dev/console 2>/dev/null)
  if [[ -z $u || $u == root || $u == _* ]]; then
    [[ -n $USER_NAME ]] && log "nobody logged in, standing by"
    USER_NAME= USER_ID= STATE_DIR=
    return 1
  fi
  if [[ $u != $USER_NAME ]]; then
    USER_NAME=$u
    USER_ID=$(id -u $u 2>/dev/null)
    home=$(dscl . -read /Users/$u NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    [[ -z $home ]] && home=/Users/$u
    STATE_DIR=$home/.stayawake
    CONFIG=$STATE_DIR/config
    STATE=$STATE_DIR/state
    LEASE=$STATE_DIR/lease
    VETO=$STATE_DIR/veto
    SCHEDULE=$STATE_DIR/schedule
    if [[ ! -d $STATE_DIR ]]; then
      mkdir -p $STATE_DIR
      chown $USER_NAME $STATE_DIR 2>/dev/null
    fi
    [[ -f $CONFIG ]] || write_defaults
    log "following user $u"
  fi
  return 0
}

# The config is user writable and this runs as root, so it is parsed, never
# sourced: only known keys, and every value validated and clamped.
load_config() {
  [[ -n $CONFIG && -r $CONFIG ]] || return
  local line key val
  while IFS= read -r line; do
    line=${line%%\#*}
    line=${line//[[:space:]]/}
    [[ -z $line || $line != *=* ]] && continue
    key=${line%%=*}
    val=${line#*=}
    case $key in
      (POLL)          [[ $val == <-> ]] && (( val >= 2 && val <= 300 ))     && POLL=$val ;;
      (IDLE_WINDOW|GRACE)
                      [[ $val == <-> ]] && (( val >= 60 && val <= 14400 ))  && IDLE_WINDOW=$val ;;
      (REMIND_EVERY)  [[ $val == <-> ]] && (( val == 0 || (val >= 900 && val <= 86400) )) && REMIND_EVERY=$val ;;
      (BATTERY_FLOOR) [[ $val == <-> ]] && (( val >= 0 && val <= 95 ))      && BATTERY_FLOOR=$val ;;
      (NOTIFY)        [[ $val == (all|forced|none) ]]                       && NOTIFY=$val ;;
      (MATCH)         [[ $val =~ '^[A-Za-z0-9_.-]+$' ]]                     && MATCH=$val ;;
    esac
  done < $CONFIG
}

# The menu bar app posts its own notifications, so that clicking one opens the
# app rather than whatever tool the helper would have used.
app_running() {
  local hb=$STATE_DIR/app-alive t
  [[ -f $hb ]] || return 1
  t=$(<$hb) 2>/dev/null
  [[ $t == <-> ]] || return 1
  (( EPOCHSECONDS - t < 15 ))
}

# $1 = class (transition|forced), $2 = message.
notify() {
  [[ $NOTIFY == none || -z $USER_ID ]] && return
  app_running && return
  [[ $NOTIFY == forced && $1 != forced ]] && return
  local msg=${2//\"/}
  launchctl asuser $USER_ID sudo -u $USER_NAME /usr/bin/osascript \
    -e "display notification \"$msg\" with title \"Stay Awake\"" >/dev/null 2>&1
}

sleep_disabled() {
  if ioreg -r -d 1 -c IOPMrootDomain 2>/dev/null | grep -q '"SleepDisabled" = Yes'; then
    print 1
  else
    print 0
  fi
}

apply() {
  local want=$1 why=$2
  local cur=$(sleep_disabled)
  [[ $cur == $want ]] && return
  pmset -a disablesleep $want
  if [[ $want == 1 ]]; then
    log "keeping awake ($why)"
    notify transition "Keeping the Mac awake: $why"
  else
    log "back to normal sleep ($why)"
    notify transition "Back to normal sleep: $why"
  fi
}

# Wake schedule. The machine's single repeating schedule (`pmset repeat`) cannot
# express several times a day, so each wanted wake is laid down as its own
# one-off event, tagged with our owner, and topped up as events are consumed.
sched_mtime=0
sched_next_check=0
next_wake=
reconcile_schedule() {
  local now=$1 mtime=0 line time days d stamp dow letter out soonest=0
  [[ -n $STATE_DIR ]] || return
  [[ -f $SCHEDULE ]] && mtime=$(stat -f %m $SCHEDULE 2>/dev/null)
  (( mtime == sched_mtime && now < sched_next_check )) && return
  sched_mtime=$mtime
  sched_next_check=$(( now + 600 ))

  local -a wanted have
  wanted=()
  if [[ -f $SCHEDULE ]]; then
    while IFS= read -r line; do
      line=${line%%\#*}
      [[ -z ${line//[[:space:]]/} ]] && continue
      time=${${(z)line}[1]}
      days=${${(z)line}[2]}
      [[ $time =~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' ]] || continue
      [[ $days =~ '^[MTWRFSU]+$' ]] || continue
      # Lay down the coming week, so a helper that is off for a day or two
      # still leaves valid events behind.
      for d in {0..7}; do
        stamp=$(strftime -r '%Y-%m-%d %H:%M' "$(strftime '%Y-%m-%d' $(( now + d * 86400 ))) $time" 2>/dev/null) || continue
        (( stamp <= now + 60 )) && continue
        dow=$(strftime '%u' $stamp)
        letter=$DOW_LETTERS[$dow]
        [[ $days == *$letter* ]] || continue
        wanted+=("$(strftime '%m/%d/%Y %H:%M:%S' $stamp)")
        (( soonest == 0 || stamp < soonest )) && soonest=$stamp
      done
    done < $SCHEDULE
  fi

  have=(${(f)"$(pmset -g sched 2>/dev/null | grep -F "by '$SCHED_OWNER'" | sed -E 's/.*at ([0-9\/]+ [0-9:]+).*/\1/')"})
  next_wake=${have[1]:-}

  local w h found
  for h in $have; do
    [[ -z $h ]] && continue
    found=0
    for w in $wanted; do [[ $w == $h ]] && { found=1; break } done
    if (( ! found )); then
      out=$(pmset schedule cancel wake "$h" "$SCHED_OWNER" 2>&1) || log "could not cancel wake $h: $out"
      log "wake cancelled: $h"
    fi
  done
  for w in $wanted; do
    found=0
    for h in $have; do [[ $w == $h ]] && { found=1; break } done
    if (( ! found )); then
      out=$(pmset schedule wake "$w" "$SCHED_OWNER" 2>&1)
      if [[ -n $out ]]; then log "could not schedule wake $w: $out"; else log "wake scheduled: $w"; fi
    fi
  done
  (( soonest > 0 )) && next_wake=$(strftime '%a %H:%M' $soonest) || next_wake=
}

# A Mac with no battery (any desktop) reports no percentage at all, which reads
# as 100% on mains, so the battery limit simply never fires there.
battery_pct=100
battery_state=ac
read_battery() {
  local out=$(pmset -g batt 2>/dev/null)
  battery_pct=${$(print -r -- $out | grep -oE '[0-9]+%' | head -1)%\%}
  [[ -z $battery_pct ]] && battery_pct=100
  if print -r -- $out | grep -q 'discharging'; then
    battery_state=discharging
  else
    battery_state=ac
  fi
}

# Reads an expiry file. 0 means no expiry; a past timestamp clears the file.
active_marker() {
  local f=$1 now=$2 exp
  [[ -f $f ]] || { print 0; return }
  exp=$(<$f) 2>/dev/null
  [[ $exp == <-> ]] || exp=0
  if (( exp == 0 || exp > now )); then print 1; else rm -f $f; print 0; fi
}

write_state() {
  local d=$1 h=$2 m=$3 v=$4
  [[ -n $STATE ]] || return
  {
    print -r -- "updated=$EPOCHSECONDS"
    print -r -- "sleep_disabled=$(sleep_disabled)"
    print -r -- "demand=$d"
    print -r -- "holders=$h"
    print -r -- "manual=$m"
    print -r -- "veto=$v"
    print -r -- "latched=$latched"
    print -r -- "hold_since=$hold_since"
    print -r -- "idle_since=$idle_since"
    print -r -- "battery_pct=$battery_pct"
    print -r -- "battery_state=$battery_state"
    print -r -- "idle_window=$IDLE_WINDOW"
    print -r -- "remind_every=$REMIND_EVERY"
    print -r -- "battery_floor=$BATTERY_FLOOR"
    print -r -- "next_wake=$next_wake"
    print -r -- "match=$MATCH"
    print -r -- "holder_names=${holder_names:-}"
    print -r -- "off=$( [[ -f $STATE_DIR/disabled ]] && print 1 || print 0 )"
  } > $STATE.tmp && mv -f $STATE.tmp $STATE
  chmod 644 $STATE 2>/dev/null
}

hold_since=0
idle_since=0
next_remind=0
latched=
prev_manual=0
holder_names=
hp= hpp= hname=

log "stayawaked starting"

# Boot reset: disablesleep survives reboots, so a crash while holding would
# otherwise leave the Mac permanently unable to sleep with no visible cause.
apply 0 "boot reset"

while true; do
  now=$EPOCHSECONDS

  if ! resolve_user; then
    apply 0 "nobody logged in"
    sleep $POLL
    continue
  fi

  load_config
  reconcile_schedule $now
  read_battery

  holders=$(pgrep -x $MATCH 2>/dev/null | wc -l | tr -d ' ')
  holder_names=
  if (( holders > 0 )); then
    for hp in ${(f)"$(pgrep -x $MATCH 2>/dev/null)"}; do
      hpp=$(ps -o ppid= -p $hp 2>/dev/null | tr -d ' ')
      hname=$(ps -o comm= -p $hpp 2>/dev/null | tr -d ' ')
      holder_names="$holder_names ${${hname:t}:-something}"
    done
    holder_names=${holder_names# }
  fi
  manual=$(active_marker $LEASE $now)
  veto=$(active_marker $VETO $now)

  demand=0
  (( holders > 0 || manual )) && demand=1

  # Master switch, owned by the app's ON/OFF toggle.
  if [[ -f $STATE_DIR/disabled ]]; then
    apply 0 "turned off"
    hold_since=0; idle_since=0; next_remind=0; latched=; prev_manual=$manual
    write_state 0 0 0 0
    sleep $POLL
    continue
  fi

  # The battery limit is the one thing that still ends a hold, and it latches so
  # it cannot re-arm on the next check. It clears on mains power, or once the
  # charge is comfortably above the floor again.
  if [[ $latched == battery ]]; then
    if [[ $battery_state != discharging ]] || (( battery_pct > BATTERY_FLOOR + 5 )); then
      log "battery limit cleared (${battery_pct}% $battery_state)"
      latched=
    fi
  fi

  if (( demand )) && [[ -z $latched ]]; then
    if [[ $battery_state == discharging ]] && (( battery_pct <= BATTERY_FLOOR )); then
      latched=battery
      log "LIMIT battery: ${battery_pct}% discharging, letting it sleep again"
      notify forced "Battery ${battery_pct}%, so the Mac can sleep again even though work is running"
    fi
  fi

  want=0
  (( demand && ! veto )) && [[ -z $latched ]] && want=1

  if (( want )); then
    idle_since=0
    if (( hold_since == 0 )); then
      hold_since=$now
      (( REMIND_EVERY > 0 )) && next_remind=$(( now + REMIND_EVERY )) || next_remind=0
    fi
    if (( manual && holders == 0 )); then
      apply 1 "you asked for it"
    else
      apply 1 "$holders working"
    fi
    # Nothing is ever cut off. This only surfaces a hold you may have forgotten.
    if (( REMIND_EVERY > 0 && next_remind > 0 && now >= next_remind )); then
      log "reminder: still keeping awake, $(( (now - hold_since) / 3600 ))h so far"
      notify forced "Still keeping the Mac awake, $(( (now - hold_since) / 3600 ))h so far"
      next_remind=$(( now + REMIND_EVERY ))
    fi
  else
    if [[ -n $latched ]]; then
      apply 0 "$latched limit reached"
      hold_since=0; idle_since=0; next_remind=0
    elif (( veto )); then
      apply 0 "you asked for it"
      hold_since=0; idle_since=0; next_remind=0
    elif (( prev_manual && ! manual && holders == 0 )); then
      # You turned the manual hold off yourself, so release straight away.
      apply 0 "you asked for it"
      hold_since=0; idle_since=0; next_remind=0
    elif (( hold_since > 0 )); then
      # Quiet, but quiet is not the same as finished: work stops and restarts
      # constantly. Only sustained quiet, IDLE_WINDOW long, allows sleep.
      (( idle_since == 0 )) && { idle_since=$now; log "quiet, allowing sleep in ${IDLE_WINDOW}s unless work resumes" }
      if (( now - idle_since >= IDLE_WINDOW )); then
        apply 0 "quiet for $(( IDLE_WINDOW / 60 ))m"
        hold_since=0; idle_since=0; next_remind=0
      fi
    else
      apply 0 "nothing working"
    fi
  fi

  write_state $demand $holders $manual $veto

  prev_manual=$manual
  sleep $POLL
done
